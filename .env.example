# Server-only settings. Restart/redeploy after changing them.
API_DISABLE_KKPHIM=0
API_DISABLE_NGUONC=0
# Audited OPhim API/CDN is unavailable. Opt in only after validating both.
API_DISABLE_OPHIM=1
API_ENABLE_OPHIM=0
# API_BASE_KKPHIM=https://phimapi.com
# API_BASE_NGUONC=https://phim.nguonc.com
# API_BASE_OPHIM=<verified API origin>
# API_CDN_OPHIM=<verified image CDN origin/path>
NEXT_PUBLIC_SITE_URL=https://hnq-film.vercel.app
# Keep API_MOCK unset in production; it is for automated tests only.
